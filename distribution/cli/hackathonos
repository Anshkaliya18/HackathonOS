#!/usr/bin/env python3
"""Deprecated compatibility launcher for the Sherpa CLI."""
from pathlib import Path
import os
import subprocess
import sys

target = Path(__file__).with_name("sherpa")
if not target.is_file():
    print("HackathonOS is now Sherpa. Install Sherpa to use the 'sherpa' command.", file=sys.stderr)
    raise SystemExit(1)
print("HackathonOS is now Sherpa. The 'hackathonos' command is deprecated; use 'sherpa'.", file=sys.stderr)
raise SystemExit(subprocess.call([sys.executable, str(target), *sys.argv[1:]]))
