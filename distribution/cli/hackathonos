#!/usr/bin/env python3
"""HackathonOS distribution CLI.

Lightweight, standard-library-only CLI for installing, updating, and
uninstalling the HackathonOS skill for Claude Code and OpenCode.

Commands:
    hackathonos --version
    hackathonos update
    hackathonos uninstall
    hackathonos doctor
    hackathonos help

The CLI never touches user project data or `.hackathon/` directories.
All network access is over HTTPS and every downloaded archive is verified
against a SHA-256 checksum before extraction.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import shutil
import sys
import tarfile
import tempfile
import zipfile
from pathlib import Path
from urllib.error import HTTPError, URLError
from urllib.request import Request, urlopen

# Ensure stdout/stderr can emit unicode without crashing on consoles that use
# a legacy code page (e.g. Windows cp1252). Fall back to replacing characters
# the console cannot render.
for _stream in (sys.stdout, sys.stderr):
    if hasattr(_stream, "reconfigure"):
        try:
            _stream.reconfigure(encoding="utf-8", errors="replace")
        except Exception:
            pass

PROJECT = "HackathonOS"
CLI_NAME = "hackathonos"

# Embedded fallback version. Overridden by a VERSION file next to this script
# when one is shipped by the installer/release.
DEFAULT_CLI_VERSION = "1.0.0"

# Default release manifest URL. Users publishing their own releases override
# this with the HACKATHONOS_RELEASE_MANIFEST_URL environment variable.
# This is the real GitHub Releases pattern for the project repository; a real
# release must be published before downloads succeed.
DEFAULT_MANIFEST_URL = (
    "https://github.com/Anshkaliya18/HackathonOS"
    "/releases/latest/download/manifest.json"
)

# Standard skill installation locations (per task specification).
CLAUDE_SKILL_DIR = Path.home() / ".claude" / "skills" / "hackathonos"
OPENCODE_SKILL_DIR = Path.home() / ".config" / "opencode" / "skills" / "hackathonos"

SKILL_DIRS = {
    "claude": CLAUDE_SKILL_DIR,
    "opencode": OPENCODE_SKILL_DIR,
}


def cli_bin_dir() -> Path:
    """Platform-specific user-writable directory for the `hackathonos` CLI."""
    if sys.platform.startswith("win"):
        return Path.home() / "AppData" / "Local" / "HackathonOS" / "bin"
    return Path.home() / ".local" / "bin"

# Files/directories that are part of the consumable skill tree.
SKILL_TREE_ENTRIES = [
    "SKILL.md",
    "commands",
    "core",
    "workflows",
    "templates",
    "rules",
    "src",
    "scripts",
    "adapters",
    "docs",
    "VERSION",
]


class HackathonOSError(Exception):
    """Fatal CLI error."""


def log(message: str, level: str = "info") -> None:
    prefix = {"info": "  >", "ok": "  ✓", "err": "  ✗", "warn": "  ⚠", "step": "[*]"}
    line = f"{prefix.get(level, '  ')} {message}"
    try:
        print(line)
    except UnicodeEncodeError:
        # Console cannot render unicode markers (e.g. Windows cp1252).
        print(line.encode("ascii", "replace").decode("ascii"))


def cli_version() -> str:
    here = Path(__file__).resolve().parent
    version_file = here / "VERSION"
    if version_file.is_file():
        return version_file.read_text(encoding="utf-8").strip()
    return DEFAULT_CLI_VERSION


def installed_version(skill_dir: Path) -> str | None:
    version_file = skill_dir / "VERSION"
    if version_file.is_file():
        return version_file.read_text(encoding="utf-8").strip()
    return None


def manifest_url() -> str:
    return os.environ.get("HACKATHONOS_RELEASE_MANIFEST_URL", DEFAULT_MANIFEST_URL)


def fetch_json(url: str, timeout: int = 30) -> dict:
    log(f"Fetching manifest: {url}")
    req = Request(url, headers={"Accept": "application/json", "User-Agent": "hackathonos-cli"})
    try:
        with urlopen(req, timeout=timeout) as response:
            if response.status != 200:
                raise HackathonOSError(f"manifest request failed: HTTP {response.status}")
            data = response.read()
    except HTTPError as exc:
        raise HackathonOSError(f"manifest request failed: HTTP {exc.code}") from exc
    except URLError as exc:
        raise HackathonOSError(f"cannot reach manifest: {exc}") from exc
    try:
        return json.loads(data.decode("utf-8"))
    except json.JSONDecodeError as exc:
        raise HackathonOSError(f"manifest is not valid JSON: {exc}") from exc


def sha256_file(path: Path, chunk_size: int = 1024 * 1024) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(chunk_size), b""):
            digest.update(block)
    return digest.hexdigest()


def download_file(url: str, dest: Path, timeout: int = 120) -> Path:
    log(f"Downloading: {url}")
    req = Request(url, headers={"User-Agent": "hackathonos-cli"})
    try:
        with urlopen(req, timeout=timeout) as response:
            if response.status != 200:
                raise HackathonOSError(f"download failed: HTTP {response.status}")
            total = response.headers.get("Content-Length")
            with dest.open("wb") as out:
                downloaded = 0
                while True:
                    block = response.read(1024 * 1024)
                    if not block:
                        break
                    out.write(block)
                    downloaded += len(block)
    except HTTPError as exc:
        raise HackathonOSError(f"download failed: HTTP {exc.code}") from exc
    except URLError as exc:
        raise HackathonOSError(f"download failed: {exc}") from exc
    log(f"Download complete ({downloaded} bytes)")
    return dest


def _is_within_directory(directory: Path, target: Path) -> bool:
    try:
        target.resolve().relative_to(directory.resolve())
        return True
    except ValueError:
        return False


def safe_extract_tar(archive: Path, dest: Path) -> None:
    """Extract a tar archive while preventing path traversal."""
    dest = dest.resolve()
    with tarfile.open(archive, "r:*") as tar:
        for member in tar.getmembers():
            member_path = (dest / member.name).resolve()
            if not _is_within_directory(dest, member_path):
                raise HackathonOSError(
                    f"unsafe archive member (path traversal): {member.name}"
                )
        tar.extractall(dest)


def safe_extract_zip(archive: Path, dest: Path) -> None:
    """Extract a zip archive while preventing path traversal."""
    dest = dest.resolve()
    with zipfile.ZipFile(archive) as zip_file:
        for member in zip_file.infolist():
            target = (dest / member.filename).resolve()
            if not _is_within_directory(dest, target):
                raise HackathonOSError(
                    f"unsafe archive member (path traversal): {member.filename}"
                )
        zip_file.extractall(dest)


def validate_skill_tree(root: Path) -> list[str]:
    """Return a list of validation problems (empty means valid)."""
    problems: list[str] = []
    skill_md = root / "SKILL.md"
    if not skill_md.is_file():
        problems.append("SKILL.md missing")
    manifest = root / "commands" / "manifest.json"
    if not manifest.is_file():
        problems.append("commands/manifest.json missing")
    router = root / "core" / "commands" / "router.py"
    if not router.is_file():
        problems.append("core/commands/router.py missing")
    workflows = root / "workflows"
    if not workflows.is_dir() or not any(workflows.glob("*.md")):
        problems.append("workflows missing or empty")
    return problems


def detect_installed() -> dict[str, Path]:
    installed: dict[str, Path] = {}
    for name, directory in SKILL_DIRS.items():
        if (directory / "SKILL.md").is_file():
            installed[name] = directory
    return installed


def platform_archive_name(manifest: dict) -> dict | None:
    """Pick the archive entry matching the current OS/arch."""
    import platform as _platform

    system = _platform.system().lower()
    machine = _platform.machine().lower()
    os_map = {"windows": "windows", "linux": "linux", "darwin": "darwin"}
    arch_map = {
        "amd64": "amd64",
        "x86_64": "amd64",
        "arm64": "arm64",
        "aarch64": "arm64",
    }
    os_key = os_map.get(system)
    arch_key = arch_map.get(machine)
    if not os_key or not arch_key:
        return None
    for entry in manifest.get("archives", []):
        if entry.get("os") == os_key and entry.get("arch") == arch_key:
            return entry
    return None


def backup_directory(path: Path) -> Path | None:
    if not path.exists():
        return None
    timestamp = __import__("datetime").datetime.now().strftime("%Y%m%d%H%M%S")
    backup = path.with_name(f"{path.name}.bak.{timestamp}")
    shutil.copytree(path, backup)
    log(f"Backed up {path} -> {backup}", "ok")
    return backup


def rollback(backups: dict[str, Path], targets: dict[str, Path]) -> None:
    log("Rolling back installation...", "warn")
    for name, directory in targets.items():
        backup = backups.get(name)
        if directory.exists():
            shutil.rmtree(directory, ignore_errors=True)
        if backup and backup.exists():
            shutil.move(str(backup), str(directory))
            log(f"Restored {name} from backup", "ok")


def install_archive(archive: Path, skill_dirs: dict[str, Path]) -> None:
    """Extract archive into a temp dir, validate, then install into skill dirs."""
    with tempfile.TemporaryDirectory(prefix="hackathonos-install-") as tmp:
        extract_root = Path(tmp)
        name = archive.name.lower()
        if name.endswith(".tar.gz") or name.endswith(".tgz"):
            safe_extract_tar(archive, extract_root)
        elif name.endswith(".zip"):
            safe_extract_zip(archive, extract_root)
        else:
            raise HackathonOSError(f"unsupported archive format: {archive.name}")

        # The archive may contain a single top-level "hackathonos" directory.
        candidates = [p for p in extract_root.iterdir() if p.is_dir()]
        source = extract_root
        if len(candidates) == 1 and (candidates[0] / "SKILL.md").is_file():
            source = candidates[0]

        problems = validate_skill_tree(source)
        if problems:
            raise HackathonOSError("invalid skill archive: " + "; ".join(problems))

        # Back up existing installations before replacing them.
        backups: dict[str, Path] = {}
        for name in skill_dirs:
            backups[name] = backup_directory(skill_dirs[name])

        try:
            for name, directory in skill_dirs.items():
                if directory.exists():
                    shutil.rmtree(directory, ignore_errors=True)
                directory.parent.mkdir(parents=True, exist_ok=True)
                shutil.copytree(source, directory)
                log(f"Installed {name} skill -> {directory}", "ok")
                # Validate after install.
                problems = validate_skill_tree(directory)
                if problems:
                    raise HackathonOSError(
                        f"installed {name} skill failed validation: " + "; ".join(problems)
                    )
        except Exception:
            rollback(backups, skill_dirs)
            raise


def cmd_version(args: argparse.Namespace) -> int:
    print(f"{CLI_NAME} {cli_version()}")
    return 0


def cmd_doctor(args: argparse.Namespace) -> int:
    print(f"=== {PROJECT} doctor ===")
    print(f"CLI version: {cli_version()}")
    print(f"OS: {sys.platform}")
    print(f"Python: {sys.version.split()[0]}")
    print(f"Manifest URL: {manifest_url()}")

    # Tool availability.
    for tool in ("curl", "tar", "unzip"):
        import shutil as _shutil

        found = _shutil.which(tool) is not None
        print(f"Tool {tool}: {'found' if found else 'missing'}")
    if sys.platform.startswith("win"):
        print(f"Tool certutil: found (Windows built-in)")
        print(f"PowerShell: {os.environ.get('PSVersionTable', '5.1+')} ")

    installed = detect_installed()
    print("Installed skills:")
    if not installed:
        print("  (none)")
    for name in ("claude", "opencode"):
        directory = SKILL_DIRS[name]
        present = name in installed
        version = installed_version(directory) if present else "not installed"
        print(f"  {name}: {directory} -> {version} {'[installed]' if present else ''}")

    # Manifest reachability.
    try:
        manifest = fetch_json(manifest_url(), timeout=10)
        print(f"Manifest reachable: yes (latest {manifest.get('latest', {}).get('version', '?')})")
    except HackathonOSError as exc:
        print(f"Manifest reachable: no ({exc})")

    return 0


def cmd_update(args: argparse.Namespace) -> int:
    installed = detect_installed()
    if not installed:
        print("No HackathonOS skill installation found. Run the installer first.")
        return 1

    manifest = fetch_json(manifest_url())
    latest = manifest.get("latest", {}).get("version", "?")

    # Determine which skill dirs to update.
    targets = {name: directory for name, directory in SKILL_DIRS.items() if name in installed}

    # Check installed versions.
    outdated = []
    for name, directory in targets.items():
        current = installed_version(directory)
        if current != latest:
            outdated.append((name, directory, current, latest))

    if not outdated:
        print(f"All installed skills are up to date (v{latest}).")
        return 0

    print(f"Update available: v{latest}")
    for name, directory, current, _ in outdated:
        print(f"  {name}: v{current or '?'} -> v{latest} ({directory})")

    archive = platform_archive_name(manifest)
    if archive is None:
        import platform as _platform

        raise HackathonOSError(
            f"No release archive for {_platform.system()}/{_platform.machine()}"
        )

    archive_url = archive.get("url")
    archive_checksum = archive.get("checksum") or ""
    if not archive_url:
        raise HackathonOSError("manifest archive entry missing URL")

    with tempfile.TemporaryDirectory(prefix="hackathonos-update-") as tmp:
        archive_path = Path(tmp) / archive_url.rsplit("/", 1)[-1]
        download_file(archive_url, archive_path)

        if archive_checksum:
            actual = sha256_file(archive_path)
            if actual.lower() != archive_checksum.lower():
                raise HackathonOSError(
                    f"checksum mismatch: expected {archive_checksum}, got {actual}"
                )
            log("SHA-256 verified", "ok")

        install_archive(archive_path, targets)
        print("Update completed successfully.")
    return 0


def cmd_uninstall(args: argparse.Namespace) -> int:
    installed = detect_installed()
    if not installed:
        print("No HackathonOS skill installation found.")
        return 0

    print(f"The following will be removed:")
    for name, directory in installed.items():
        print(f"  {name} skill: {directory}")
    cli_bin = cli_bin_dir()
    cli_exe = cli_bin / CLI_NAME
    if cli_exe.exists():
        print(f"  CLI: {cli_exe}")
    print()
    print("User project data (.hackathon/ directories) will NOT be removed.")
    print()

    if not args.assume_yes:
        reply = input("Proceed with uninstallation? [y/N]: ").strip().lower()
        if reply not in ("y", "yes"):
            print("Uninstallation cancelled.")
            return 0

    removed = []
    for name, directory in installed.items():
        shutil.rmtree(directory, ignore_errors=True)
        removed.append(str(directory))
        log(f"Removed {name} skill", "ok")

    if cli_exe.exists():
        cli_exe.unlink()
        removed.append(str(cli_exe))
        log(f"Removed CLI {cli_exe}", "ok")

    print("Uninstallation completed.")
    return 0


def cmd_help(args: argparse.Namespace) -> int:
    print(f"""{PROJECT} distribution CLI

Usage:
    hackathonos --version       Show the CLI version
    hackathonos update          Update installed skills to the latest release
    hackathonos uninstall       Remove installed skills (preserves user data)
    hackathonos doctor          Diagnose the installation environment
    hackathonos help            Show this help

Environment variables:
    HACKATHONOS_RELEASE_MANIFEST_URL
        Override the release manifest URL (default: GitHub Releases).

Installation locations:
    Claude Code:  ~/.claude/skills/hackathonos/
    OpenCode:     ~/.config/opencode/skills/hackathonos/

Skill entry point:
    /hackathonos   (invoke in Claude Code or OpenCode)

More information: INSTALLATION.md, README.md
""")
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog=CLI_NAME,
        description=f"{PROJECT} distribution CLI.",
    )
    parser.add_argument(
        "--version",
        action="store_true",
        help="show the CLI version and exit",
    )
    sub = parser.add_subparsers(dest="command")

    p_update = sub.add_parser("update", help="update installed skills to the latest release")
    p_update.add_argument("--yes", "-y", dest="assume_yes", action="store_true",
                          help="skip confirmation prompts")
    p_update.set_defaults(func=cmd_update)

    p_uninstall = sub.add_parser("uninstall", help="remove installed skills")
    p_uninstall.add_argument("--yes", "-y", dest="assume_yes", action="store_true",
                             help="skip confirmation prompts")
    p_uninstall.set_defaults(func=cmd_uninstall)

    sub.add_parser("doctor", help="diagnose the installation environment").set_defaults(func=cmd_doctor)
    sub.add_parser("help", help="show this help message").set_defaults(func=cmd_help)

    return parser


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)

    # `--version` can appear anywhere; handle before subparser parsing.
    if "--version" in argv:
        print(f"{CLI_NAME} {cli_version()}")
        return 0

    parser = build_parser()
    args = parser.parse_args(argv)
    if not getattr(args, "command", None) and not args.version:
        parser.print_help()
        return 1
    func = getattr(args, "func", None)
    if func is None:
        parser.print_help()
        return 1
    return func(args)


if __name__ == "__main__":
    raise SystemExit(main())
