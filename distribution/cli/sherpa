    return 0


def cmd_migrate(args: argparse.Namespace) -> int:
    root = Path(args.project_root).expanduser().resolve()
    source = root / ".hackathon"
    target = root / ".sherpa"
    if source.is_symlink() or target.is_symlink():
        raise sherpaError("migration refuses symlinked state directories")
    if not source.is_dir():
        print(f"No legacy state found at {source}.")
        return 0
    if target.exists():
        raise sherpaError(f"{target} already exists; migration will not overwrite it")
    print(f"Copy legacy state {source} -> {target}. The original will be preserved.")
    if not args.assume_yes and input("Continue? [y/N]: ").strip().lower() not in ("y", "yes"):
        print("Migration cancelled.")
        return 0
    shutil.copytree(source, target, symlinks=True)
    print(f"Copied legacy state to {target}; original data remains at {source}.")
    return 0


def audit_paths() -> list[Path]:
    """Find obvious generated debris inside managed skill directories only."""
    candidates: list[Path] = []
    patterns = ("*.tmp", "*.log", "*.bak", "*.pyc")
    for root in detect_installed().values():
        for pattern in patterns:
            candidates.extend(p for p in root.rglob(pattern) if p.is_file())
        candidates.extend(p for p in root.rglob("__pycache__") if p.is_dir())
    # Keep any files tracked by the nearest Git worktree out of cleanup scope.
    safe: list[Path] = []
    for root in detect_installed().values():
        try:
            result = subprocess.run(["git", "-C", str(root), "ls-files", "-z"], capture_output=True, check=False)
            tracked = {((root / item).resolve()) for item in result.stdout.decode(errors="replace").split("\0") if item}
        except OSError:
            tracked = set()
        safe.extend(path for path in candidates if path == root or root in path.parents if path.resolve() not in tracked)
    return sorted(set(safe))


def cmd_audit(args: argparse.Namespace) -> int:
    found = audit_paths()
    roots = list(detect_installed().values())
    files = [p for root in roots for p in root.rglob("*") if p.is_file()]
    required = ["SKILL.md", "commands/manifest.json", "core/commands/router.py", "workflows/"]
    hashes: dict[str, list[Path]] = {}
    for path in files:
        hashes.setdefault(sha256_file(path), []).append(path)
    duplicates = [group for group in hashes.values() if len(group) > 1]
    empty_dirs = [p for root in roots for p in root.rglob("*") if p.is_dir() and not any(p.iterdir())]
    temporary = [p for p in found if p.suffix.lower() in (".tmp", ".log", ".pyc", ".bak") or p.name == "__pycache__"]
    print("Sherpa output audit")
    print(f"Total files scanned: {len(files)}")
    print("Required files:")
    for item in required:
        print(f"- {item}")
    print("Unwanted files:")
    for path in found:
        print(f"- {path}")
    print("Temporary files:")
    for path in temporary:
        print(f"- {path}")
    print("Duplicate files:")
    for group in duplicates:
        print("- " + " = ".join(str(path) for path in group))
    print("Empty directories:")
    for path in empty_dirs:
        print(f"- {path}")
    print("Recommended cleanup: run `sherpa clean --dry-run`; cleanup requires `--yes`.")
    return 0


def cmd_clean(args: argparse.Namespace) -> int:
    found = audit_paths()
    print("Dry run — no files will be removed." if args.dry_run or not args.assume_yes else "Cleaning managed generated files.")
    for path in found:
        print(f"- {path}")
        if not args.dry_run and args.assume_yes:
            if not path.exists():
                continue
            if path.is_dir():
                shutil.rmtree(path)
            else:
                path.unlink()
    if not args.dry_run and not args.assume_yes:
        print("Pass --yes to authorize removal of listed files.")
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog=CLI_NAME,
        description=f"{PROJECT} distribution CLI.",
    )
    parser.add_argument(
        "--version",
        action="store_true",
        help="show the CLI version and exit",
    )
    sub = parser.add_subparsers(dest="command")

    p_update = sub.add_parser("update", help="update installed skills to the latest release")
    p_update.add_argument("--yes", "-y", dest="assume_yes", action="store_true",
                          help="skip confirmation prompts")
    p_update.set_defaults(func=cmd_update)

    p_uninstall = sub.add_parser("uninstall", help="remove installed skills")
    p_uninstall.add_argument("--yes", "-y", dest="assume_yes", action="store_true",
                             help="skip confirmation prompts")
    p_uninstall.set_defaults(func=cmd_uninstall)

    sub.add_parser("doctor", help="diagnose the installation environment").set_defaults(func=cmd_doctor)
    p_migrate = sub.add_parser("migrate", help="copy legacy .hackathon state without deleting it")
    p_migrate.add_argument("--project-root", default=".", help="project directory (default: current directory)")
    p_migrate.add_argument("--yes", "-y", dest="assume_yes", action="store_true", help="skip confirmation")
    p_migrate.set_defaults(func=cmd_migrate)
    sub.add_parser("audit", help="report generated debris in managed installations").set_defaults(func=cmd_audit)
    p_clean = sub.add_parser("clean", help="report or remove generated debris in managed installations")
    p_clean.add_argument("--dry-run", action="store_true", help="report only (default)")
    p_clean.add_argument("--yes", "-y", dest="assume_yes", action="store_true", help="authorize removal")
    p_clean.set_defaults(func=cmd_clean)
    sub.add_parser("help", help="show this help message").set_defaults(func=cmd_help)

    return parser


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)

    # `--version` can appear anywhere; handle before subparser parsing.
    if "--version" in argv:
        print(f"{CLI_NAME} {cli_version()}")
        return 0

    parser = build_parser()
    args = parser.parse_args(argv)
    if not getattr(args, "command", None) and not args.version:
        parser.print_help()
        return 1
    func = getattr(args, "func", None)
    if func is None:
        parser.print_help()
        return 1
    return func(args)


if __name__ == "__main__":
    raise SystemExit(main())
