{
    "name": "sherpa-skill",
    "version": "2.0.7",
    "description": "AI hackathon mentor skill and multi-agent plugin for Claude Code, Codex, Gemini CLI, Qwen Code, OpenCode, and Kilo Code",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "https://github.com/Anshkaliya18/sherpa.git"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org"
    },
    "bin": {
        "sherpa": "distribution/npm/sherpa.mjs"
    },
    "files": [
        "distribution/install.sh",
        "distribution/install.ps1",
        "distribution/uninstall.sh",
        "distribution/uninstall.ps1",
        "distribution/cli/sherpa",
        "distribution/cli/sherpa.bat",
        "distribution/npm/",
        "SKILL.md",
        "skills/",
        ".agents/plugins/marketplace.json",
        ".agents/skills/sherpa/SKILL.md",
        ".agents/skills/sherpa/commands/",
        ".agents/skills/sherpa/core/**/*.py",
        ".agents/skills/sherpa/workflows/",
        ".agents/skills/sherpa/rules/",
        ".agents/skills/sherpa/templates/",
        ".agents/skills/sherpa/src/**/*.py",
        ".agents/skills/sherpa/docs/commands/README.md",
        ".agents/skills/sherpa/docs/configuration/runtime-verification.md",
        ".claude-plugin/",
        ".codex-plugin/",
        "plugin.json",
        "gemini-extension.json",
        "qwen-extension.json",
        "GEMINI.md",
        "skills/sherpa/SKILL.md",
        "skills/sherpa/commands/",
        "skills/sherpa/core/**/*.py",
        "skills/sherpa/workflows/",
        "skills/sherpa/rules/",
        "skills/sherpa/templates/",
        "skills/sherpa/src/**/*.py",
        "skills/sherpa/docs/commands/README.md",
        "skills/sherpa/docs/configuration/runtime-verification.md"
    ],
    "scripts": {
        "prepack": "python scripts/prepare-agent-package.py",
        "docs:dev": "vitepress dev docs",
        "docs:build": "vitepress build docs",
        "predocs:build": "node scripts/generate-command-reference.mjs",
        "predocs:dev": "node scripts/generate-command-reference.mjs",
        "docs:preview": "vitepress preview docs",
        "docs:check": "node scripts/check-docs.mjs",
        "docs:commands": "node scripts/generate-command-reference.mjs"
    },
    "devDependencies": {
        "mermaid": "^11.12.0",
        "vitepress": "^1.6.4",
        "vitepress-plugin-mermaid": "^2.0.17"
    }
}
