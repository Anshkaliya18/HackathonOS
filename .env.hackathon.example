# HackathonOS Environment Configuration Template
# Copy this file to .env.hackathon and fill in your own values.
# NEVER commit actual API keys or secrets to this file.

# Hackathon Identity
HACKATHON_NAME=
HACKATHON_PLATFORM=
HACKATHON_URL=
HACKATHON_DASHBOARD_URL=
START_DATE_TIME=
DEADLINE_DATE_TIME=
TIMEZONE=
HACKATHON_ORGANIZER=
HACKATHON_CONTACT=
HACKATHON_THEME=
ELIGIBILITY_REQUIREMENTS=
PRIZE_INFORMATION=

# Problem & Idea
PROBLEM_STATEMENT=
TARGET_USERS=
SELECTED_IDEA=
PRODUCT_CONCEPT=
MVP_SCOPE=
MVP_FEATURES=
KEY_DIFFERENTIATORS=

# Judging Criteria & Rules
HACKATHON_RULES_SUMMARY=
JUDGING_CRITERIA=
JUDGING_CRITERIA_WEIGHTS=
SUBMISSION_REQUIREMENTS=
OPTIONAL_DELIVERABLES=

# Tech Stack
PROGRAMMING_LANGUAGES=
FRONTEND_FRAMEWORK=
BACKEND_FRAMEWORK=
DATABASE=
AI_ML_PROVIDER=
AI_MODEL_NAME=
DEPLOYMENT_PLATFORM=
OTHER_TECHNOLOGIES=

# Environment Variables (Non-Secret)
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
API_BASE_URL=
APP_PORT=
APP_HOST=
LOG_LEVEL=INFO
ENVIRONMENT=development

# Project Status & Deliverables
CURRENT_PHASE=INITIALIZATION
COMPLETED_WORKSTREAMS=
CURRENT_WORKSTREAM=
BLOCKED_WORKSTREAMS=
COMPLETED_FEATURES=
MVP_STATUS=
DEMO_STATUS=
PPT_STATUS=
DOCUMENTATION_STATUS=
DEPLOYMENT_URL=
GITHUB_REPOSITORY_URL=
DEMO_URL=

# Custom Variables
# Add your own variables below:
# KEY=value
