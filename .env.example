# ==============================
# HACKATHONOS PROJECT CONFIG
# Copy to `.env` in your hackathon project if you need environment overrides.
# Empty values mean UNKNOWN; never put secrets in this example.
# ==============================

# Hackathon facts
HACKATHON_NAME=
HACKATHON_URL=
HACKATHON_PLATFORM=
HACKATHON_EDITION=
HACKATHON_DEADLINE=
HACKATHON_TIMEZONE=

# Project facts
PROJECT_NAME=
PROJECT_PATH=
GITHUB_REPOSITORY=
DEPLOYMENT_URL=

# Agent selection (metadata only; does not prove provider connectivity)
AGENT_PLATFORM=
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=

# Capability preferences
ENABLE_WEB_RESEARCH=true
ENABLE_AUTO_VERIFY=true
ENABLE_RED_TEAM=true
ENABLE_VIDEO_ASSIST=true

# Autonomous safety limits
MAX_AUTO_ITERATIONS=5
MAX_AUTO_FIXES=10
REQUIRE_HUMAN_APPROVAL=true
